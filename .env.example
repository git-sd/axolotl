# Copy to .env.local and fill in. .env.local is git-ignored; never commit a real key.

# Required: get one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional spending limits (defaults shown). Set any of the first three to 0 to pause scans.

# Scans each visitor (by IP) can start per hour
SCAN_LIMIT_PER_HOUR=3
# Scans everyone together can start per day
SCAN_DAILY_BUDGET=20
# Scans that can run at the same time
SCAN_MAX_CONCURRENT=3
# Re-scanning the same site within this many minutes reuses the result, free
SCAN_CACHE_MINUTES=60

# Agents running at once within one scan. TinyFish allows 2 per run on the standard plan.
SCAN_AGENT_CONCURRENCY=2
# The longest one agent may work, in seconds, before it is stopped and left unscored
SCAN_AGENT_SECONDS=230
# Time budget for the whole scan, in seconds. Keep under your host's request limit
# (Vercel free plan: 300).
SCAN_TOTAL_SECONDS=270
# The least time worth giving an agent. Concurrency x budget / this = how many tasks run
# (2 x 270 / 110 = 4 of the 6; the most important run first, the rest are "not run").
SCAN_MIN_AGENT_SECONDS=110
